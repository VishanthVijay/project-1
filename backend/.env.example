# Application
APP_NAME="Habit Tracker API"
DEBUG=False

# Database (Leave DATABASE_URL unset for MySQL, or set sqlite for dev)
DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_password
DB_NAME=habit_tracker

# JWT Authentication (Generate a strong 64-char random string in production)
SECRET_KEY=generate_a_secure_production_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
